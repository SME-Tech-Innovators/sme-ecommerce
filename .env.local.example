# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit it.

# Backend API base URL (no trailing slash).
# For local development: http://localhost:8080/api/v1
# For the deployed Azure backend: https://sme-operations-gpgudcaud8bddgdu.canadacentral-01.azurewebsites.net/api/v1
NEXT_PUBLIC_SME_API_BASE_URL=http://localhost:8080/api/v1

# Public frontend origin for storefront links and Paystack callbacks.
# Defaults to window.location.origin in the browser; set this for SSR/build-time use.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# OpenAI API key — server-side only, never exposed to the browser.
# Required for the "Generate with AI" feature in the product form.
# Get a key at https://platform.openai.com/api-keys
# Leave blank to disable the AI feature (button will show as unavailable).
OPENAI_API_KEY=
